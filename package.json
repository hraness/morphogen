{
  "name": "@hraness/morphogen",
  "version": "0.3.1",
  "description": "Typed, replayable workflow organisms: deterministic structure, bounded agent cells, replayable receipts.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "exports": {
    ".": "./index.ts",
    "./manifest": "./src/manifest.ts",
    "./contract": "./src/contract.ts"
  },
  "bin": {
    "morphogen": "./cli.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "index.ts",
    "cli.ts",
    "src",
    "spec",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p site/tsconfig.json",
    "lint": "eslint .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build:site",
    "build:site": "bun site/build.ts",
    "generate:og": "bun site/generate-og.tsx",
    "cli": "bun cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.6.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "^1.2.0",
    "eslint": "^9.13.0",
    "react": "19.2.3",
    "satori": "0.33.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "@hraness/design-kit": "github:hraness/design-kit#v0.16.2",
    "@hraness/site-footer": "github:hraness/site-footer#v0.19.0",
    "@hraness/ui": "github:hraness/ui#v0.5.18",
    "react-dom": "19.2.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agentic-workflows",
    "llm",
    "typed-graph",
    "replay",
    "hraness"
  ]
}
